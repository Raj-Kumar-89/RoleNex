# Server Environment file
server/.env

# Ignore everything inside uploads
server/uploads/*

# Allow companies folder and all its contents
!server/uploads/companies/

# Allow other folders to preserve their structure
!server/uploads/employees/
!server/uploads/jobseekers/
!server/uploads/resumes/

# Ignore all files inside these folders
server/uploads/employees/*
server/uploads/jobseekers/*
server/uploads/resumes/*

# Keep placeholder files
!server/uploads/companies/.gitkeep
!server/uploads/employees/.gitkeep
!server/uploads/jobseekers/.gitkeep
!server/uploads/resumes/.gitkeep